{
  "name": "@llm-wiki/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "bun run verify-migrations && tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "bun run verify-migrations && bun run src/ensure-extensions.ts && drizzle-kit migrate",
    "verify-migrations": "bun run src/verify-migrations.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2"
  }
}
