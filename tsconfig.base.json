{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@llm-wiki/ai": ["./packages/ai/src/index.ts"],
      "@llm-wiki/ai/*": ["./packages/ai/src/*"],
      "@llm-wiki/db": ["./packages/db/src/index.ts"],
      "@llm-wiki/db/*": ["./packages/db/src/*"],
      "@llm-wiki/obsidian": ["./packages/obsidian/src/index.ts"],
      "@llm-wiki/obsidian/*": ["./packages/obsidian/src/*"],
      "@llm-wiki/types": ["./packages/types/src/index.ts"],
      "@llm-wiki/types/*": ["./packages/types/src/*"],
      "@llm-wiki/core": ["./packages/core/src/index.ts"],
      "@llm-wiki/core/*": ["./packages/core/src/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  }
}
