# Core Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_wiki
VAULT_PATH=./vault
API_PORT=3001

# AI Provider Configuration (gemini-geap, gemini, ollama, openai, fallback)
EMBEDDING_PROVIDER=fallback
LLM_PROVIDER=fallback
GEMINI_API_KEY=
TAVILY_API_KEY=

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3
OLLAMA_EVALUATOR_MODEL=

# Evaluation Settings
EVALUATOR_MODE=auto
ALLOW_CLOUD_VAULT_EVALUATION=false

# OpenAI Settings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini

# Groq Settings
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# OpenRouter Settings
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=google/gemma-4-31b-it:free

# BazaarLink Settings
BAZAARLINK_API_KEY=
BAZAARLINK_BASE_URL=https://bazaarlink.ai/api/v1
BAZAARLINK_LLM_MODEL=gpt-4o-mini

# GCP / ADC Settings
GOOGLE_CLOUD_PROJECT=
GEMINI_GCP_LOCATION=global
GEMINI_GCP_LLM_MODEL=gemini-2.5-flash
GEMINI_GCP_EMBEDDING_MODEL=gemini-embedding-001

# Application Settings
WATCHER_DEBOUNCE_MS=5000
EMBEDDING_VERSION=v1
SEMANTIC_DUPLICATE_THRESHOLD=0.92
SEMANTIC_DUPLICATE_CANDIDATES=200
EVALUATION_TARGET_MODE=local
