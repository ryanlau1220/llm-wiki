{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "VAULT_PATH",
    "EMBEDDING_PROVIDER",
    "LLM_PROVIDER",
    "GOOGLE_CLOUD_PROJECT",
    "GCLOUD_PROJECT",
    "GEMINI_GCP_LOCATION",
    "GEMINI_API_KEY",
    "EMBEDDING_VERSION",
    "WATCHER_DEBOUNCE_MS",
    "SEMANTIC_DUPLICATE_THRESHOLD",
    "SEMANTIC_DUPLICATE_CANDIDATES",
    "OLLAMA_BASE_URL",
    "OLLAMA_LLM_MODEL",
    "OLLAMA_EVALUATOR_MODEL",
    "EVALUATOR_MODE",
    "ALLOW_CLOUD_VAULT_EVALUATION",
    "CLOUD_EVALUATOR_PROVIDER",
    "CLOUD_EVALUATOR_MODEL",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "OPENAI_LLM_MODEL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "^check"
      ],
      "outputs": []
    }
  }
}
