{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schemas/ai-actions.schema.json",
  "title": "LLM Wiki AI Actions",
  "description": "Validated action envelope for all AI intents.",
  "type": "object",
  "required": [
    "request_id",
    "action",
    "payload"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Correlation id from caller.",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "type": "string",
      "enum": [
        "create_note",
        "refactor_note",
        "suggest_links",
        "search"
      ]
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/createNotePayload"
        },
        {
          "$ref": "#/$defs/refactorNotePayload"
        },
        {
          "$ref": "#/$defs/suggestLinksPayload"
        },
        {
          "$ref": "#/$defs/searchPayload"
        }
      ]
    },
    "reason": {
      "type": "string",
      "description": "Short explanation of why this action is suggested.",
      "maxLength": 500
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "create_note"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/createNotePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "refactor_note"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/refactorNotePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "suggest_links"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/suggestLinksPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "search"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/searchPayload"
          }
        }
      }
    }
  ],
  "$defs": {
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,50}$"
    },
    "link": {
      "type": "string",
      "description": "Obsidian-style note title or path without extension.",
      "minLength": 1,
      "maxLength": 200
    },
    "createNotePayload": {
      "type": "object",
      "required": [
        "title",
        "content"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "links": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/link"
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/tag"
          },
          "uniqueItems": true
        },
        "source": {
          "type": "string",
          "enum": [
            "ask",
            "synthesis",
            "manual"
          ]
        }
      },
      "additionalProperties": false
    },
    "refactorNotePayload": {
      "type": "object",
      "required": [
        "source_path",
        "title",
        "content"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "description": "Path under vault/human/",
          "pattern": "^human\\/.+\\.md$",
          "maxLength": 400
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "links": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/link"
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/tag"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "suggestLinksPayload": {
      "type": "object",
      "required": [
        "source_path",
        "candidate_links"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "pattern": "^human\\/.+\\.md$",
          "maxLength": 400
        },
        "candidate_links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/link"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "searchPayload": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 8
        },
        "include_ai_generated": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
